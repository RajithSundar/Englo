# ===============================================
# Englo Studio Environment Configuration Template
# ===============================================

# Server Environment
PORT=3000
NODE_ENV=development

# Google Cloud Vertex AI Configuration (Optional: defaults to deterministic heuristic engine if omitted)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
MODEL_FAST=gemini-2.5-flash
MODEL_PRO=gemini-2.5-pro

# Razorpay Standard & RazorpayX Testnet Keys (Optional: testnet mock active by default)
RAZORPAY_KEY_ID=rzp_test_EngloBuildathon
RAZORPAY_KEY_SECRET=sandbox_secret_englo_buildathon_2026

# Optional: Spline scene for the landing page's 3D IDE (the .splinecode URL from
# Spline's Export -> Code panel). Without it, the built-in CSS 3D model is shown.
# VITE_SPLINE_IDE_SCENE=https://prod.spline.design/<id>/scene.splinecode
# Spline scene units per CSS pixel when exploding the layers (default 1).
# VITE_SPLINE_IDE_SCALE=1
